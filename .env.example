# Application
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tampa_vip_automation
PUBLIC_BASE_URL=http://localhost:8000
BUSINESS_TIMEZONE=America/New_York
LOG_LEVEL=INFO
SENTRY_DSN=

# Dashboard authentication: oidc is recommended; basic is for local recovery only.
ADMIN_AUTH_MODE=basic
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-me
ADMIN_ALLOWED_EMAILS=
ADMIN_ALLOWED_DOMAIN=

# PoolBrain
POOLBRAIN_API_BASE_URL=https://prodapi.poolbrain.com
POOLBRAIN_API_KEY=
POOLBRAIN_WEBHOOK_SIGNING_SECRET=
POOLBRAIN_COMPLETED_JOB_LOOKBACK_DAYS=2

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
COMPANY_PHONE_NUMBER=
ALERT_PHONE_NUMBER=
TEST_PHONE_NUMBER=

# Google Business Profile
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/google/oauth/callback
GOOGLE_REVIEW_URL=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
GOOGLE_SYNC_ENABLED=false

# Encryption key for OAuth credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Microsoft Entra / Outlook
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/microsoft/oauth/callback
MICROSOFT_ADMIN_REDIRECT_URI=http://localhost:8000/auth/callback
MICROSOFT_WEBHOOK_CLIENT_STATE=
OUTLOOK_SENDER_ADDRESS=
OUTLOOK_BOUNCE_FOLDER=Inbox
OUTLOOK_SEND_ENABLED=false
OUTLOOK_BOUNCE_SYNC_ENABLED=false

# Review campaign schedule
REVIEW_SMS_DELAY_HOURS=3
REVIEW_EMAIL_HOUR=10
REVIEW_SUPPRESSION_DAYS=120
MESSAGE_MAX_ATTEMPTS=5
MESSAGE_LEASE_MINUTES=10

# Privacy and operational retention (used by the daily cleanup command)
MESSAGE_CONTENT_RETENTION_DAYS=90
OPERATIONAL_EVENT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
